{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/alpadalar/ccinfobar/main/schema/config.schema.json",
  "title": "ccinfobar config",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "lines": {
      "type": "array",
      "description": "Status lines, top to bottom",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "model",
                "provider",
                "effort",
                "thinking",
                "fast-mode",
                "output-style",
                "session-name",
                "session-id",
                "claude-version",
                "vim-mode",
                "agent-name",
                "skills",
                "context-percentage",
                "context-bar",
                "context-length",
                "context-window-size",
                "compactions",
                "tokens-input",
                "tokens-output",
                "tokens-cached",
                "tokens-total",
                "cache-hit-rate",
                "cache-timer",
                "cache-miss-cause",
                "performance",
                "output-speed",
                "session-cost",
                "cost-today",
                "cost-week",
                "cost-project",
                "budget",
                "cost-rate",
                "session-duration",
                "api-duration",
                "lines-changed",
                "message-count",
                "five-hour-usage",
                "five-hour-reset",
                "weekly-usage",
                "weekly-reset",
                "weekly-model-usage",
                "weekly-model-reset",
                "weekly-sonnet-usage",
                "weekly-opus-usage",
                "spend-limit",
                "usage-pace",
                "usage-projection",
                "limit-eta",
                "limit-risk",
                "token-rate-graph",
                "output-speed-graph",
                "context-graph",
                "usage-graph",
                "cost-graph",
                "todo-list",
                "agents",
                "agent-count",
                "tool-activity",
                "turn-timer",
                "permission-wait",
                "gsd-milestone",
                "gsd-milestone-progress",
                "gsd-phase",
                "gsd-status",
                "gsd-plans",
                "gsd-plan-progress",
                "gsd-next",
                "gsd-workstream",
                "gsd-blockers",
                "gsd-todos",
                "gsd-requirements",
                "gsd-last-command",
                "gsd-update",
                "gsd-task",
                "gsd-summary",
                "git-branch",
                "git-sha",
                "git-changes",
                "git-status",
                "git-staged",
                "git-unstaged",
                "git-untracked",
                "git-ahead-behind",
                "git-conflicts",
                "git-stash",
                "git-operation",
                "git-repo",
                "git-worktree",
                "pr",
                "workspace-repos",
                "cwd",
                "project-dir",
                "clock",
                "date",
                "hostname",
                "username",
                "memory",
                "env-counts",
                "load-average",
                "terminal-width",
                "platform",
                "service-status",
                "command",
                "link",
                "env",
                "http",
                "text",
                "separator",
                "flex"
              ]
            },
            "color": {
              "type": "string",
              "description": "Named color (red, brightBlue...), ansi256:N, #rrggbb or default"
            },
            "background": {
              "type": "string",
              "description": "Named color (red, brightBlue...), ansi256:N, #rrggbb or default"
            },
            "bold": {
              "type": "boolean"
            },
            "dim": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "description": "Replaces the default label"
            },
            "raw": {
              "type": "boolean",
              "description": "Show only the value"
            },
            "merge": {
              "type": "boolean",
              "description": "Join with the next widget without a separator"
            },
            "hideEmpty": {
              "type": "boolean",
              "description": "Hide the widget when it has no data instead of showing —; false shows — for widgets that hide themselves"
            },
            "options": {
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "boolean"]
              }
            },
            "showWhen": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "maxItems": 8
                }
              ],
              "description": "Show the widget only when the rule holds"
            },
            "hideWhen": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "maxItems": 8
                }
              ],
              "description": "Hide the widget when the rule holds"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "With overflow: priority, lower values are dropped first (default: from the category)"
            }
          }
        }
      }
    },
    "theme": {
      "type": "string",
      "description": "Built-in theme id or the name of a file in the themes folder",
      "examples": [
        "classic",
        "minimal",
        "mono",
        "neon",
        "pastel",
        "amber",
        "matrix",
        "blocks",
        "slate",
        "paper",
        "powerline",
        "nord",
        "dracula",
        "gruvbox",
        "tokyo-night",
        "solarized",
        "monochrome",
        "dark",
        "light",
        "rose-pine",
        "panel",
        "catppuccin",
        "bubblegum"
      ],
      "default": "classic"
    },
    "style": {
      "enum": ["text", "blocks", "powerline", "capsule", "tui"],
      "description": "Overrides the theme style"
    },
    "separator": {
      "type": "string",
      "description": "Overrides the theme separator"
    },
    "separatorColor": {
      "type": "string",
      "description": "Overrides the theme separator color"
    },
    "padding": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Overrides the theme padding"
    },
    "glyphs": {
      "type": "object",
      "description": "Glyphs for powerline and capsule styles",
      "properties": {
        "separator": {
          "type": "string",
          "description": "Between powerline segments"
        },
        "thin": {
          "type": "string",
          "description": "Between powerline segments that share a color"
        },
        "startCap": {
          "type": "string"
        },
        "endCap": {
          "type": "string"
        }
      }
    },
    "charset": {
      "enum": ["auto", "nerd", "unicode", "text"],
      "default": "auto",
      "description": "auto: unicode in Apple Terminal, nerd elsewhere. text: ASCII-only for terminals without Unicode or Nerd Fonts"
    },
    "align": {
      "enum": ["left", "center", "right"],
      "default": "left",
      "description": "Where lines sit in the terminal; in the panel style, where the box sits when it is narrower"
    },
    "lineAlign": {
      "type": "array",
      "items": {
        "enum": ["left", "center", "right", null]
      },
      "description": "Alignment per line, by index; null follows align"
    },
    "autoWrap": {
      "type": "boolean",
      "default": true,
      "description": "Move widgets that do not fit to a new line instead of truncating"
    },
    "overflow": {
      "enum": ["truncate", "wrap", "priority"],
      "description": "What happens when a line is too wide: cut it, wrap to a new line, or drop low-priority widgets (default: from autoWrap)"
    },
    "glyphMode": {
      "enum": ["normal", "single-width", "paste-safe", "jetbrains", "auto"],
      "description": "single-width folds emoji and fullwidth text to narrow glyphs, paste-safe also drops Nerd Font glyphs and links so pasted text stays aligned, jetbrains counts emoji as one column, auto picks jetbrains in JetBrains terminals (default: normal)"
    },
    "ambiguousWidth": {
      "enum": [1, 2],
      "description": "Width of East Asian ambiguous characters; 2 for CJK-locale terminals (default: 1)"
    },
    "update": {
      "enum": ["auto", "notify", "off"],
      "default": "auto",
      "description": "auto installs new releases in the background, notify shows a note, off never checks"
    },
    "usageApi": {
      "type": "boolean",
      "default": true,
      "description": "Fill usage limit widgets from Claude when Claude Code does not send rate_limits"
    },
    "gitHardening": {
      "type": "boolean",
      "default": true,
      "description": "Ignore repo-local core.fsmonitor and filter drivers when ccinfobar runs git"
    },
    "loadingText": {
      "type": "string",
      "maxLength": 40,
      "default": "loading…",
      "description": "Shown by context and token widgets before the first reply; empty string turns it off"
    },
    "budget": {
      "type": "object",
      "description": "Soft spending limits in USD for the budget widget",
      "properties": {
        "daily": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Estimated spend per day across sessions"
        },
        "session": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Estimated spend per session"
        },
        "warnAt": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1,
          "default": 0.8,
          "description": "Fraction of the budget where the widget turns yellow"
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "description": "Terminal progress bar (OSC 9;4) driven by context or 5-hour usage",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "source": {
          "enum": ["context", "usage5h"],
          "default": "context"
        },
        "scaleTo": {
          "enum": ["full", "autocompact"],
          "default": "full",
          "description": "autocompact shows the auto-compact point as 100%"
        },
        "warnAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50,
          "description": "Percent for warning state"
        },
        "errorAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 80,
          "description": "Percent for error state"
        },
        "channel": {
          "enum": ["auto", "hook", "tty"],
          "default": "auto",
          "description": "hook sends it through Claude Code hooks, tty writes to the terminal (POSIX only)"
        },
        "tmuxPassthrough": {
          "type": "boolean",
          "default": false,
          "description": "Wrap the sequence for tmux"
        },
        "terminals": {
          "enum": ["allowlist", "always"],
          "default": "allowlist",
          "description": "allowlist emits only in terminals known to draw it"
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "description": "Model names, context windows and prices for third-party providers (built-ins updated 2026-10-14)",
      "properties": {
        "builtIn": {
          "type": "boolean",
          "default": true,
          "description": "Use the built-in table for GLM, Kimi, DeepSeek, MiniMax and Qwen models"
        },
        "models": {
          "type": "array",
          "maxItems": 100,
          "description": "Your own model profiles; they win over the built-ins and the first match wins",
          "items": {
            "type": "object",
            "required": ["match"],
            "properties": {
              "match": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Case-insensitive glob on the model id or display name; only * is special"
              },
              "label": {
                "type": "string",
                "maxLength": 60,
                "description": "Name shown for the model"
              },
              "contextWindow": {
                "type": "integer",
                "minimum": 1,
                "description": "Context window in tokens"
              },
              "input": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Input price per 1M tokens"
              },
              "output": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Output price per 1M tokens"
              },
              "cacheRead": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Cache read price per 1M tokens"
              },
              "cacheWrite": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Cache write price per 1M tokens"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "default": "USD",
                "description": "Three-letter currency code of the prices"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "gsdAutoLine": {
      "type": "boolean",
      "description": "Set by ccinfobar when it left the GSD line out because GSD was not installed"
    },
    "tui": {
      "type": "object",
      "description": "Settings for the tui (panel) style",
      "properties": {
        "box": {
          "anyOf": [
            {
              "enum": [
                "rounded",
                "square",
                "heavy",
                "double",
                "dashed",
                "heavy-dashed",
                "mixed",
                "ascii",
                "invisible"
              ]
            },
            {
              "type": "object",
              "properties": {
                "topLeft": {
                  "type": "string"
                },
                "topRight": {
                  "type": "string"
                },
                "bottomLeft": {
                  "type": "string"
                },
                "bottomRight": {
                  "type": "string"
                },
                "horizontal": {
                  "type": "string"
                },
                "vertical": {
                  "type": "string"
                },
                "teeLeft": {
                  "type": "string"
                },
                "teeRight": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ],
          "default": "rounded"
        },
        "fitContent": {
          "type": "boolean",
          "default": false,
          "description": "Shrink the panel to its content"
        },
        "minWidth": {
          "type": "integer",
          "minimum": 10,
          "default": 32
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 10
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "default": 1
        },
        "columnGap": {
          "type": "string",
          "description": "Text between grid columns or widgets (default: theme separator)"
        },
        "divider": {
          "type": "string",
          "description": "Character for divider rows"
        },
        "borderColor": {
          "type": "string",
          "description": "Border color; \"context\" shifts from green to red as the context window fills"
        },
        "dividers": {
          "type": "boolean",
          "default": true,
          "description": "Divider between config lines when no breakpoints are set"
        },
        "title": {
          "type": "object",
          "properties": {
            "left": {
              "type": "string",
              "default": "{model}",
              "description": "Text with {widget} tokens"
            },
            "right": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "const": false
                }
              ],
              "default": "ccinfobar"
            }
          }
        },
        "footer": {
          "type": "object",
          "properties": {
            "left": {
              "type": "string"
            },
            "right": {
              "type": "string"
            }
          }
        },
        "templates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gap": {
                "type": "integer",
                "minimum": 0
              },
              "justify": {
                "enum": ["start", "between"]
              }
            }
          }
        },
        "breakpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["minWidth", "areas"],
            "properties": {
              "minWidth": {
                "type": "integer",
                "minimum": 0
              },
              "areas": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Rows of space separated cell names, \".\" or \"---\""
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(auto|\\d*\\.?\\d*fr|\\d+)$"
                }
              },
              "align": {
                "type": "array",
                "items": {
                  "enum": ["left", "center", "right"]
                }
              }
            }
          }
        }
      }
    },
    "colorLevel": {
      "enum": ["auto", 0, 1, 2, 3],
      "default": "auto"
    },
    "icons": {
      "enum": ["nerd", "emoji", "text", "none"],
      "default": "text"
    },
    "maxWidth": {
      "anyOf": [
        {
          "const": "auto"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "default": "auto"
    },
    "widthOffset": {
      "type": "integer",
      "minimum": 0,
      "default": 10
    },
    "savePayload": {
      "type": "boolean",
      "default": true
    }
  }
}
