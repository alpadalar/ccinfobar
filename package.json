{
  "name": "ccinfobar",
  "version": "0.8.2",
  "description": "Status line for Claude Code with a drag-and-drop web editor and a terminal editor, 117 widgets, 30 themes and a marketplace; zero dependencies, TypeScript, Windows, macOS and Linux, safe install and uninstall",
  "keywords": [
    "claude",
    "claude-code",
    "statusline",
    "status-line",
    "gsd",
    "get-shit-done",
    "powerline",
    "cli",
    "claude-code-statusline",
    "status-bar",
    "editor",
    "tui",
    "themes",
    "widgets",
    "marketplace",
    "windows",
    "macos",
    "linux",
    "zero-dependency",
    "typescript"
  ],
  "homepage": "https://github.com/alpadalar/ccinfobar#readme",
  "bugs": {
    "url": "https://github.com/alpadalar/ccinfobar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpadalar/ccinfobar.git"
  },
  "license": "MIT",
  "author": "Alperen Adalar",
  "type": "module",
  "bin": {
    "ccinfobar": "dist/ccinfobar.js"
  },
  "files": [
    "dist/",
    "schema/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "start": "node dist/ccinfobar.js",
    "example": "node dist/ccinfobar.js --payload test/fixtures/payload.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "node scripts/build.mjs --docs && biome format --write schema",
    "demo": "node scripts/build.mjs --demo",
    "screenshots": "node scripts/screenshots.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run build && npm run check",
    "version": "node scripts/sync-plugin-version.mjs && git add plugin/.claude-plugin/plugin.json INSTALL.md README.md"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.149.0"
  }
}
